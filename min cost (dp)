#include<bits/stdc++.h>
using namespace std;
int n,k;
int dp[1001];
void solve(){
    cin>>n>>k;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    dp[0]=arr[0];
    for(int i=1;i<n;i++){
        int jmin=max(i-k,0);
        int jmax=i-1;
        dp[i]=1e9;
        for(int j=jmin;j<=jmax;j++){
            dp[i]=min(dp[j]+arr[i],dp[i]);
        }
    }
    cout<<dp[n-1]<<"\n";
}
signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    solve();
}
